# Site URL — must match exactly what's stored in client_configs.site_url in NGF admin
NEXT_PUBLIC_SITE_URL=westmiwindowtint.com

# NGF app (content API) — leave as-is unless overriding
NGF_APP_URL=https://app.ngfsystems.com

# Revalidation secret — must match WEBSITE_REVALIDATION_SECRET in NGF Vercel env vars
WEBSITE_REVALIDATION_SECRET=your-secret-here

# Cookie consent banner — set to 1 on any site that loads cookie-based
# analytics. Required here because of NEXT_PUBLIC_GA_ID below. With this unset
# the banner never shows, so consent is never granted and GA4 never loads.
# Set in Vercel for Production + Preview.
NEXT_PUBLIC_COOKIE_ANALYTICS=1

# GA4 measurement ID for this client's own property. GA is consent-gated, so it
# loads only after the visitor accepts the banner. Leave unset and the analytics
# component renders nothing (safe no-op) — the site still works.
# Also paste the NUMERIC property ID into NGF admin -> Website Connections so
# Zach sees his traffic in the portal dashboard.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Quote form — only used if the site's own form at /api/quote is restored.
# /quote currently embeds Tintly's hosted form, which bypasses this route.
# NOTE: the route reads EMAIL_TO / EMAIL_FROM — an earlier version of this file
# documented QUOTE_RECIPIENT_EMAIL, which the code never reads, so a setup
# following it would 500 with "Recipient not configured".
RESEND_API_KEY=re_...
EMAIL_TO=zach@westmiwindowtint.com
EMAIL_FROM=noreply@westmiwindowtint.com
